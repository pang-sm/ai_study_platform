# 智学AI — AI Provider API Key 配置模板（EXAMPLE ONLY，绝无真实 value）
# 复制为 backend/.env.local 并填入真实 key（backend/.env.local 已被 gitignore）。
# 不要提交任何真实 key。

# DeepSeek（官方直连）
DEEPSEEK_API_KEY=

# Alibaba Cloud Model Studio / Qwen（DashScope）
DASHSCOPE_API_KEY=

# Volcengine Ark / Doubao
ARK_API_KEY=

# Moonshot / Kimi
MOONSHOT_API_KEY=

# Zhipu / GLM（BigModel）
ZHIPUAI_API_KEY=

# MiniMax
MINIMAX_API_KEY=
