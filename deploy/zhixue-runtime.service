[Unit]
Description=ZhixueAI Scientific Runtime Service (zhixue-runtime)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/zhixue-runtime/scientific_runtime_service
Environment=ZHIXUE_HOME=/opt/zhixue-runtime
Environment=ZHIXUE_RUNTIME_SRC=/opt/zhixue-runtime/zhixue-runtime-v1-phase1gr-student-twin/src
ExecStart=/opt/zhixue-runtime/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8101
Restart=on-failure
RestartSec=5
# Loopback only — never bind 0.0.0.0, never proxy via public nginx.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
